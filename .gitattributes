# Keep Windows line endings out of the repo for text; never touch binary payloads.
* text=auto eol=lf

# Unreal assets and compiled payloads are binary - no newline translation, no diff.
*.uasset binary
*.umap  binary
*.so    binary
*.dll   binary
*.lib   binary
*.png   binary
*.jpg   binary
*.tps   binary

# Source and docs
*.h    text eol=lf
*.hpp  text eol=lf
*.cpp  text eol=lf
*.cs   text eol=lf
*.usf  text eol=lf
*.ini  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
# The upstream SDK ships this .bat with bare-LF line endings and it is hashed in the
# delivery manifest, so checkout must not rewrite it to CRLF.
*.bat  -text
*.uplugin text eol=lf

# Evidence artifacts are raw machine output captured on Windows. They are checksummed
# in docs/PATCH_REPORT.txt and in the delivery manifest, so their bytes must survive a
# clone unchanged: no newline translation at all.
evidence/** -text
docs/PATCH_REPORT.txt -text